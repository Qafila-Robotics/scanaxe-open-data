# Businesses in the Gulf and MENA with an official website. Wikidata, CC0 1.0. No people.
SELECT ?item ?label_en ?label_ar ?country_iso ?website ?industry ?employees WHERE {
  VALUES ?country_iso { "AE" "SA" "QA" "KW" "BH" "OM" "EG" "JO" "LB" "MA" "TN" "DZ" }
  ?country wdt:P297 ?country_iso .
  { ?item wdt:P17 ?country } UNION { ?item wdt:P159/wdt:P17 ?country }
  ?item wdt:P31/wdt:P279* wd:Q4830453 ;
        wdt:P856 ?website .
  OPTIONAL { ?item rdfs:label ?label_en FILTER(LANG(?label_en) = "en") }
  OPTIONAL { ?item rdfs:label ?label_ar FILTER(LANG(?label_ar) = "ar") }
  OPTIONAL { ?item wdt:P452 ?ind . ?ind rdfs:label ?industry FILTER(LANG(?industry) = "en") }
  OPTIONAL { ?item wdt:P1128 ?employees }
}
